# ============================================================================
# Agente Escritor — Plantilla de configuración
# ============================================================================
# Copia este archivo a `.env` y rellena tus valores.
# El `.env` real NUNCA debe subirse a Git (ya está en .gitignore).
#
# Alternativa: exporta las variables en tu shell antes de ejecutar.
# ============================================================================

# API key del proveedor LLM (compatible con la API de OpenAI).
DEEPSEEK_API_KEY=sk-tu-clave-aqui

# URL base del proveedor (por defecto, DeepSeek).
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Integraciones opcionales ────────────────────────────────────────────────
# Token de GitHub para la funcionalidad de publicación (dejar vacío si no se usa).
GITHUB_TOKEN=

# Token de Notion para sincronización (dejar vacío si no se usa).
NOTION_TOKEN=
